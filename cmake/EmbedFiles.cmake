# Writes a C++ source that holds files as byte arrays, for tachyon::detail::EmbeddedFile.
# Run as a script:
#
#   cmake -DOUTPUT=<file.cpp> -DFUNCTION=<name> "-DFILES=<key>=<path>|<key>=<path>|..." -P EmbedFiles.cmake
#
# The source defines std::span<const tachyon::detail::EmbeddedFile> tachyon::detail::<name>(),
# one entry per file, named by its key. The output is only replaced when it changes.

if(NOT OUTPUT OR NOT FUNCTION)
  message(FATAL_ERROR "EmbedFiles.cmake needs OUTPUT and FUNCTION")
endif()

set(_source "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n")
string(APPEND _source "#include <gui_core/gui_embedded_files_internal.h>\n\n")
string(APPEND _source "namespace tachyon::detail\n{\n")

set(_entries "")
set(_index 0)
if(FILES)
  string(REPLACE "|" ";" _files "${FILES}")
  string(APPEND _source "    namespace\n    {\n")
  foreach(_file IN LISTS _files)
    string(FIND "${_file}" "=" _split)
    string(SUBSTRING "${_file}" 0 ${_split} _key)
    math(EXPR _pathStart "${_split} + 1")
    string(SUBSTRING "${_file}" ${_pathStart} -1 _path)

    file(READ "${_path}" _hex HEX)
    string(LENGTH "${_hex}" _hexLength)
    math(EXPR _size "${_hexLength} / 2")
    if(_size EQUAL 0)
      set(_bytes "0x00")
    else()
      # 32 bytes a line. CMake regexes have no {n}, so the line's pattern is spelled out.
      string(REPEAT "[0-9a-f][0-9a-f]" 32 _line)
      string(REGEX REPLACE "(${_line})" "\\1\n" _hex "${_hex}")
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
      string(REPLACE "\n" "\n            " _bytes "${_bytes}")
    endif()

    string(APPEND _source "        // ${_key}\n")
    string(APPEND _source "        alignas(16) const unsigned char kFile${_index}[] = {\n            ${_bytes}\n        };\n")
    string(APPEND _entries "            { \"${_key}\", { reinterpret_cast<const std::byte*>(kFile${_index}), ${_size} } },\n")
    math(EXPR _index "${_index} + 1")
  endforeach()
  string(APPEND _source "    }\n\n")
endif()

string(APPEND _source "    std::span<const EmbeddedFile> ${FUNCTION}()\n    {\n")
if(_index EQUAL 0)
  string(APPEND _source "        return {};\n")
else()
  string(APPEND _source "        static const EmbeddedFile files[] = {\n${_entries}        };\n")
  string(APPEND _source "        return files;\n")
endif()
string(APPEND _source "    }\n}\n")

file(WRITE "${OUTPUT}.tmp" "${_source}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
# Newer than the inputs even when unchanged, or Visual Studio runs this again on every build.
file(TOUCH_NOCREATE "${OUTPUT}")
