@PACKAGE_INIT@

# TachyonUI: C++ GUI library (gui_core, gui_controls).
#
#   find_package(TachyonUI 0.1 CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE TachyonUI::gui_controls)
#
# Provides:
#   TachyonUI::gui_core, TachyonUI::gui_controls   static libraries
#   TachyonUI_RESOURCE_DIR                            optional themes, fonts and icons; the
#                                                        library has the default ones built in
#   TACHYON_RESOURCE_DIR (compile definition)         the same folder, for
#                                                        GUIApplication::SetResourceRoot
#   TACHYON_SDL_TARGET                                the SDL target the libraries link
#                                                        (SDL3::SDL3-static when bundled)
#
# The package is built with MSVC for Windows x64 and links the same toolchain
# as its consumer; mixing C++ runtimes or standard library versions is not
# supported. Debug and Release are installed side by side; a consumer that uses
# other configurations maps them itself (CMAKE_MAP_IMPORTED_CONFIG_<CONFIG>).

include(CMakeFindDependencyMacro)

# The install prefix doubles as the prefix of the bundled third-party libraries.
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
find_dependency(Vulkan)
if(@TACHYON_SDL@)
  find_dependency(SDL3 CONFIG)
  # The SDL the libraries link, for a consumer that calls SDL too.
  set(TACHYON_SDL_TARGET "@TACHYON_SDL_TARGET@")
endif()
# harfbuzz links Threads::Threads where it uses pthreads, without finding it.
find_dependency(Threads)
find_dependency(harfbuzz CONFIG)
find_dependency(SheenBidi CONFIG)
find_dependency(libunibreak CONFIG)
find_dependency(budouxc CONFIG)
find_dependency(skribidi CONFIG)
if(@TACHYON_SYSTEM_VMA@)
  find_dependency(VulkanMemoryAllocator CONFIG)
else()
  find_dependency(vma CONFIG)
endif()
find_dependency(nanosvg CONFIG)
find_dependency(vkbootstrap CONFIG)

# The libraries link skribidi under its short name.
if(TARGET skribidi::skribidi AND NOT TARGET skribidi)
  add_library(skribidi ALIAS skribidi::skribidi)
endif()

if(NOT TARGET TachyonUI::gui_core)
  include("${CMAKE_CURRENT_LIST_DIR}/TachyonUITargets.cmake")
endif()

set_and_check(TachyonUI_RESOURCE_DIR "@PACKAGE_TACHYON_RESOURCE_INSTALL_DIR@")
set_property(TARGET TachyonUI::gui_controls APPEND PROPERTY
  INTERFACE_COMPILE_DEFINITIONS "TACHYON_RESOURCE_DIR=\"${TachyonUI_RESOURCE_DIR}\"")

check_required_components(TachyonUI)
